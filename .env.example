# Neon PostgreSQL connection string
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Ollama local LLM (used to structure raw X.com tweet captions into event fields)
# Defaults to http://localhost:11434 if not set
OLLAMA_BASE=http://localhost:11434

# Ollama model to use for event structuring
# Run: ollama pull llama3
# Defaults to llama3 if not set
OLLAMA_MODEL=llama3
